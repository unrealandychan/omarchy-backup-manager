#!/usr/bin/env python3
"""
omarchy-backup-ctl - Control and inspect dotfiles backup and synchronization
"""

import sys
import os
import json
import subprocess
import re
import selectors
import time
from datetime import datetime, timezone

DOTFILES_DIR = os.path.expanduser("~/dotfiles")
TIMER_UNIT = "omarchy-dotfiles-backup.timer"
SERVICE_UNIT = "omarchy-dotfiles-backup.service"
USER_SYSTEMD_DIR = os.path.expanduser("~/.config/systemd/user")
TIMER_FILE = os.path.join(USER_SYSTEMD_DIR, TIMER_UNIT)
DOTFILES_TIMER_FILE = os.path.join(DOTFILES_DIR, ".config/systemd/user", TIMER_UNIT)

FREQUENCY_MAP = {
    "1h": ("*-*-* *:00:00", "Every 1 hour"),
    "2h": ("*-*-* 00/2:00:00", "Every 2 hours"),
    "4h": ("*-*-* 00/4:00:00", "Every 4 hours"),
    "6h": ("*-*-* 00/6:00:00", "Every 6 hours"),
    "12h": ("*-*-* 00/12:00:00", "Every 12 hours"),
    "daily": ("*-*-* 00:00:00", "Daily at midnight"),
    "disabled": (None, "Manual only (Disabled)"),
}

CALENDAR_TO_FREQ = {
    "*-*-* *:00:00": "1h",
    "*-*-* 00/2:00:00": "2h",
    "*-*-* 00/4:00:00": "4h",
    "*-*-* 00/6:00:00": "6h",
    "*-*-* 00/12:00:00": "12h",
    "*-*-* 00:00:00": "daily",
    "daily": "daily",
}


def write_file_safely(filepath, content, mode=0o644):
    """
    Safely and atomically writes content to filepath without following planted symlinks.
    """
    dirname = os.path.dirname(filepath)
    if not os.path.exists(dirname):
        os.makedirs(dirname, mode=0o700, exist_ok=True)

    if os.path.islink(dirname):
        raise RuntimeError(f"Refusing to write through symlinked directory: {dirname}")

    dir_stat = os.stat(dirname)
    current_uid = os.getuid()
    if dir_stat.st_uid != current_uid:
        raise PermissionError(f"Directory {dirname} is owned by UID {dir_stat.st_uid}, not {current_uid}")

    # If the destination exists or is a symlink, verify ownership and remove symlinks
    if os.path.lexists(filepath):
        st = os.lstat(filepath)
        if st.st_uid != current_uid:
            raise PermissionError(f"File {filepath} is owned by UID {st.st_uid}, not {current_uid}")
        if os.path.islink(filepath):
            os.unlink(filepath)

    temp_path = None
    try:
        import tempfile
        with tempfile.NamedTemporaryFile("w", dir=dirname, delete=False) as tf:
            temp_path = tf.name
            tf.write(content)
            tf.flush()
            os.fsync(tf.fileno())

        os.chmod(temp_path, mode)
        os.replace(temp_path, filepath)
        temp_path = None
    finally:
        if temp_path and os.path.exists(temp_path):
            try:
                os.unlink(temp_path)
            except OSError:
                pass


MAX_OUTPUT_BYTES = 64 * 1024  # 64 KB cap enforced while reading child pipes


def run_cmd(args, cwd=None, check=False, timeout=15):
    try:
        proc = subprocess.Popen(
            args,
            cwd=cwd,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
    except Exception as e:
        return "", str(e)[:1024], 1

    stdout_chunks = []
    stderr_chunks = []
    stdout_len = 0
    stderr_len = 0

    sel = selectors.DefaultSelector()
    if proc.stdout:
        os.set_blocking(proc.stdout.fileno(), False)
        sel.register(proc.stdout, selectors.EVENT_READ, data='stdout')
    if proc.stderr:
        os.set_blocking(proc.stderr.fileno(), False)
        sel.register(proc.stderr, selectors.EVENT_READ, data='stderr')

    start_time = time.time()
    timed_out = False

    try:
        while sel.get_map():
            remaining = timeout - (time.time() - start_time)
            if remaining <= 0:
                timed_out = True
                break
            events = sel.select(timeout=min(max(remaining, 0.05), 0.5))
            for key, _ in events:
                stream_name = key.data
                fileobj = key.fileobj
                try:
                    data = fileobj.read(4096)
                except (BlockingIOError, InterruptedError):
                    continue
                if not data:
                    sel.unregister(fileobj)
                    continue

                if stream_name == 'stdout':
                    if stdout_len < MAX_OUTPUT_BYTES:
                        to_take = min(len(data), MAX_OUTPUT_BYTES - stdout_len)
                        stdout_chunks.append(data[:to_take])
                        stdout_len += to_take
                else:
                    if stderr_len < MAX_OUTPUT_BYTES:
                        to_take = min(len(data), MAX_OUTPUT_BYTES - stderr_len)
                        stderr_chunks.append(data[:to_take])
                        stderr_len += to_take
    finally:
        sel.close()

    remaining_wait = timeout - (time.time() - start_time)
    if remaining_wait <= 0 or timed_out:
        proc.kill()
        proc.wait()
        return "", "Command timed out", 124

    try:
        proc.wait(timeout=max(remaining_wait, 0.01))
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()
        return "", "Command timed out", 124

    out = b"".join(stdout_chunks).decode("utf-8", errors="replace").strip()
    err = b"".join(stderr_chunks).decode("utf-8", errors="replace").strip()
    return out, err, proc.returncode


def calculate_relative_time(epoch_time):
    now = datetime.now().timestamp()
    diff = int(now - epoch_time)
    if diff < 0:
        return "just now"
    if diff < 60:
        return f"{diff}s ago"
    minutes = diff // 60
    if minutes < 60:
        return f"{minutes}m ago"
    hours = minutes // 60
    if hours < 24:
        return f"{hours}h ago"
    days = hours // 24
    if days == 1:
        return "yesterday"
    if days < 30:
        return f"{days}d ago"
    months = days // 30
    return f"{months}mo ago"


def get_current_frequency():
    if not os.path.exists(TIMER_FILE):
        return "4h", FREQUENCY_MAP["4h"][1]
    
    # Check if timer is active
    out, _, code = run_cmd(["systemctl", "--user", "is-active", TIMER_UNIT])
    if out != "active":
        return "disabled", FREQUENCY_MAP["disabled"][1]

    try:
        with open(TIMER_FILE, "r") as f:
            content = f.read()
        match = re.search(r"OnCalendar=(.+)", content)
        if match:
            cal = match.group(1).strip()
            freq = CALENDAR_TO_FREQ.get(cal, "custom")
            label = FREQUENCY_MAP.get(freq, (None, f"Custom ({cal})"))[1]
            return freq, label
    except Exception:
        pass
    return "4h", FREQUENCY_MAP["4h"][1]


def get_status():
    status_data = {
        "status": "idle",
        "last_backup_time": "Never",
        "last_backup_relative": "Never",
        "last_commit_hash": "",
        "last_commit_subject": "",
        "timer_active": False,
        "frequency": "4h",
        "frequency_label": "Every 4 hours",
        "next_trigger": "",
        "remote_url": "",
        "remote_display": "",
        "branch": "main",
        "uncommitted_changes": 0,
        "unpushed_commits": 0,
        "history": [],
    }

    # Check if service is currently running
    srv_out, _, _ = run_cmd(["systemctl", "--user", "is-active", SERVICE_UNIT])
    if srv_out in ("activating", "active"):
        status_data["status"] = "syncing"

    # Git details in ~/dotfiles
    if os.path.isdir(DOTFILES_DIR):
        # Branch
        branch, _, _ = run_cmd(["git", "rev-parse", "--abbrev-ref", "HEAD"], cwd=DOTFILES_DIR)
        if branch:
            status_data["branch"] = branch

        # Remote URL
        remote, _, _ = run_cmd(["git", "remote", "get-url", "origin"], cwd=DOTFILES_DIR)
        status_data["remote_url"] = remote
        if remote:
            # Short display: e.g., unrealandychan/omarchy-dotfiles
            clean_remote = re.sub(r"^(https?://[^/]+/|git@[^:]+:)", "", remote)
            clean_remote = re.sub(r"\.git$", "", clean_remote)
            status_data["remote_display"] = clean_remote

        # Last commit
        last_commit, _, _ = run_cmd(
            ["git", "log", "-1", "--format=%H|%h|%ct|%s"],
            cwd=DOTFILES_DIR,
        )
        if last_commit:
            parts = last_commit.split("|", 3)
            if len(parts) == 4:
                full_h, short_h, ts, subj = parts
                status_data["last_commit_hash"] = full_h
                status_data["last_commit_short"] = short_h
                epoch = int(ts)
                dt = datetime.fromtimestamp(epoch)
                status_data["last_backup_time"] = dt.strftime("%Y-%m-%d %H:%M:%S")
                status_data["last_backup_relative"] = calculate_relative_time(epoch)
                status_data["last_commit_subject"] = subj

        # Uncommitted changes
        st_out, _, _ = run_cmd(["git", "status", "--porcelain"], cwd=DOTFILES_DIR)
        if st_out:
            status_data["uncommitted_changes"] = len([l for l in st_out.split("\n") if l.strip()])

        # Unpushed commits
        if branch and remote:
            unpushed, _, _ = run_cmd(
                ["git", "log", f"origin/{branch}..{branch}", "--oneline"],
                cwd=DOTFILES_DIR,
            )
            if unpushed:
                status_data["unpushed_commits"] = len([l for l in unpushed.split("\n") if l.strip()])

        # History (last 5 commits)
        hist_out, _, _ = run_cmd(
            ["git", "log", "-5", "--format=%H|%h|%ct|%s"],
            cwd=DOTFILES_DIR,
        )
        if hist_out:
            for line in hist_out.split("\n"):
                if not line.strip():
                    continue
                parts = line.split("|", 3)
                if len(parts) == 4:
                    full_h, short_h, ts, subj = parts
                    ep = int(ts)
                    status_data["history"].append({
                        "hash": full_h,
                        "short_hash": short_h,
                        "relative": calculate_relative_time(ep),
                        "date": datetime.fromtimestamp(ep).strftime("%Y-%m-%d %H:%M"),
                        "subject": subj,
                    })

    # Systemd timer details
    timer_active, _, _ = run_cmd(["systemctl", "--user", "is-active", TIMER_UNIT])
    status_data["timer_active"] = (timer_active == "active")
    freq, freq_label = get_current_frequency()
    status_data["frequency"] = freq
    status_data["frequency_label"] = freq_label

    if status_data["timer_active"]:
        show_out, _, _ = run_cmd([
            "systemctl", "--user", "show", TIMER_UNIT,
            "--property=NextElapseUSecRealtime,TimersCalendar",
        ])
        for line in show_out.split("\n"):
            if line.startswith("NextElapseUSecRealtime="):
                val = line.split("=", 1)[1].strip()
                if val:
                    status_data["next_trigger"] = val

    return status_data


def set_frequency(freq):
    if freq not in FREQUENCY_MAP:
        return {
            "success": False,
            "error": f"Invalid frequency '{freq}'. Options: {', '.join(FREQUENCY_MAP.keys())}",
        }

    cal_spec, label = FREQUENCY_MAP[freq]

    if freq == "disabled":
        run_cmd(["systemctl", "--user", "stop", TIMER_UNIT])
        run_cmd(["systemctl", "--user", "disable", TIMER_UNIT])
        return {
            "success": True,
            "frequency": "disabled",
            "message": "Automated backup disabled.",
        }

    timer_content = f"""[Unit]
Description=Periodic automated dotfiles backup to GitHub
Documentation=https://github.com/unrealandychan/omarchy-dotfiles

[Timer]
OnBootSec=10min
OnCalendar={cal_spec}
Persistent=true

[Install]
WantedBy=timers.target
"""
    try:
        write_file_safely(TIMER_FILE, timer_content)

        # Sync to dotfiles repo as well
        dotfiles_dir = os.path.dirname(DOTFILES_TIMER_FILE)
        if os.path.isdir(dotfiles_dir) and not os.path.islink(dotfiles_dir):
            write_file_safely(DOTFILES_TIMER_FILE, timer_content)
    except Exception as e:
        return {
            "success": False,
            "error": f"Failed to safely write systemd timer: {e}",
        }

    run_cmd(["systemctl", "--user", "daemon-reload"])
    run_cmd(["systemctl", "--user", "enable", "--now", TIMER_UNIT])

    return {
        "success": True,
        "frequency": freq,
        "frequency_label": label,
        "message": f"Backup frequency updated to {label}.",
    }


def set_remote(url):
    url = url.strip()
    if not url:
        return {"success": False, "error": "Remote URL cannot be empty."}
    
    out, err, code = run_cmd(["git", "remote", "set-url", "origin", url], cwd=DOTFILES_DIR)
    if code != 0:
        return {"success": False, "error": err or "Failed to set git remote."}

    return {"success": True, "remote_url": url, "message": f"Git remote URL updated to {url}"}


def set_branch(branch):
    branch = branch.strip()
    if not branch:
        return {"success": False, "error": "Branch cannot be empty."}

    out, err, code = run_cmd(["git", "checkout", branch], cwd=DOTFILES_DIR)
    if code != 0:
        return {"success": False, "error": err or f"Failed to checkout branch {branch}"}

    return {"success": True, "branch": branch, "message": f"Switched branch to {branch}"}


def backup_now(wait=False):
    sync_script = os.path.join(DOTFILES_DIR, "sync.sh")
    if not os.path.exists(sync_script):
        return {"success": False, "error": "sync.sh not found in ~/dotfiles"}

    if wait:
        out, err, code = run_cmd([sync_script], cwd=DOTFILES_DIR)
        return {
            "success": (code == 0),
            "output": out,
            "error": err if code != 0 else "",
            "message": "Backup completed successfully." if code == 0 else "Backup failed.",
        }
    else:
        # Start via systemd service
        out, err, code = run_cmd(["systemctl", "--user", "start", SERVICE_UNIT])
        return {
            "success": (code == 0),
            "message": "Backup started in background via systemd service.",
            "error": err if code != 0 else "",
        }


def restore(commit=None, expected_commit=None, **kwargs):
    target_spec = commit or expected_commit
    if target_spec in ("--head", "--local", "head", "local"):
        target_spec = "HEAD"

    if not target_spec:
        return {
            "success": False,
            "error": "Explicit commit required: specify --commit <COMMIT_SHA> (or --head to confirm local HEAD) to bind restore to an exact verified commit.",
        }

    if not os.path.isdir(DOTFILES_DIR):
        return {"success": False, "error": f"Dotfiles directory {DOTFILES_DIR} not found"}

    if os.path.islink(DOTFILES_DIR):
        return {"success": False, "error": f"Dotfiles directory {DOTFILES_DIR} cannot be a symlink"}

    dir_stat = os.stat(DOTFILES_DIR)
    if dir_stat.st_uid != os.getuid():
        return {"success": False, "error": f"Dotfiles directory {DOTFILES_DIR} is owned by UID {dir_stat.st_uid}, not {os.getuid()}"}

    # Resolve target commit using git rev-parse --verify
    commit_input = target_spec.strip()
    if not re.match(r"^[0-9a-zA-Z._~^/@-]+$", commit_input):
        return {"success": False, "error": f"Invalid git commit reference format: {commit_input}"}

    target_commit, rev_err, rev_code = run_cmd(
        ["git", "rev-parse", "--verify", f"{commit_input}^{{commit}}"],
        cwd=DOTFILES_DIR
    )
    if rev_code != 0 or not re.match(r"^[0-9a-fA-F]{40}$", target_commit):
        return {"success": False, "error": f"Cannot resolve commit '{commit_input}': {rev_err or 'unknown commit'}"}

    # Verify working tree cleanliness
    _, _, diff_all = run_cmd(["git", "diff", "--quiet", "HEAD"], cwd=DOTFILES_DIR)
    if diff_all != 0:
        return {
            "success": False,
            "error": f"Cannot restore to commit {target_commit[:7]}: working directory has uncommitted changes. Stash or commit them first.",
        }

    # Get current HEAD
    current_head, _, _ = run_cmd(["git", "rev-parse", "HEAD"], cwd=DOTFILES_DIR)

    # Checkout commit if needed
    if target_commit != current_head:
        _, _, co_code = run_cmd(["git", "checkout", "--detach", target_commit], cwd=DOTFILES_DIR)
        if co_code != 0:
            return {"success": False, "error": f"Failed to checkout commit {target_commit[:7]}"}

    # Locate restore script
    restore_script = None
    rel_script = None
    for candidate in ("install.sh", "restore.sh"):
        p = os.path.join(DOTFILES_DIR, candidate)
        if os.path.exists(p):
            restore_script = p
            rel_script = candidate
            break

    if not restore_script or not rel_script:
        return {"success": False, "error": "Neither install.sh nor restore.sh found in ~/dotfiles"}

    # Bind and verify executable content
    if os.path.islink(restore_script):
        return {"success": False, "error": f"Restore script {restore_script} cannot be a symlink"}

    script_stat = os.lstat(restore_script)
    if script_stat.st_uid != os.getuid():
        return {"success": False, "error": f"Restore script {restore_script} is owned by UID {script_stat.st_uid}, not {os.getuid()}"}

    # Verify script is tracked at this exact commit
    _, _, code = run_cmd(["git", "ls-files", "--error-unmatch", rel_script], cwd=DOTFILES_DIR)
    if code != 0:
        return {"success": False, "error": f"Restore script {rel_script} is not tracked in git repository at {target_commit}"}

    # Verify working copy has no modifications vs target commit
    _, _, diff_code = run_cmd(["git", "diff", "--quiet", target_commit, "--", rel_script], cwd=DOTFILES_DIR)
    if diff_code != 0:
        return {"success": False, "error": f"Executable script {rel_script} has uncommitted modifications vs confirmed commit {target_commit}. Failing closed."}

    # Byte-for-byte verify disk content against committed blob using git object hash
    disk_blob_hash, _, disk_code = run_cmd(["git", "hash-object", "--", rel_script], cwd=DOTFILES_DIR)
    if disk_code != 0 or not disk_blob_hash:
        return {"success": False, "error": f"Failed to compute hash for {rel_script} on disk"}

    commit_blob_hash, _, commit_code = run_cmd(["git", "rev-parse", f"{target_commit}:{rel_script}"], cwd=DOTFILES_DIR)
    if commit_code != 0 or not commit_blob_hash:
        return {"success": False, "error": f"Failed to retrieve committed blob hash for {rel_script} at {target_commit}"}

    if disk_blob_hash.strip() != commit_blob_hash.strip():
        return {"success": False, "error": f"Disk content of {rel_script} ({disk_blob_hash}) does not match committed blob at {target_commit} ({commit_blob_hash}). Failing closed."}

    out, err, code = run_cmd([restore_script], cwd=DOTFILES_DIR)
    if code != 0:
        return {
            "success": False,
            "error": err or out or "Failed to execute restore script",
            "message": "Restore failed.",
        }

    # Reload hyprland if available
    run_cmd(["hyprctl", "reload"])

    msg = f"Dotfiles and system configurations restored successfully! (Commit {target_commit[:7]})"
    run_cmd([
        "notify-send",
        "-i", "document-revert",
        "-a", "Omarchy Backup Manager",
        "Dotfiles Restored",
        msg,
    ])

    return {
        "success": True,
        "message": msg,
        "commit": target_commit,
        "output": out,
    }


def get_logs(lines=25):
    out, err, _ = run_cmd([
        "journalctl", "--user", "-u", SERVICE_UNIT,
        "-n", str(lines), "--no-pager"
    ])
    return {"success": True, "logs": out}


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "status"

    if cmd in ("status", "--status"):
        res = get_status()
        print(json.dumps(res, indent=2))
    elif cmd in ("backup-now", "--backup-now"):
        wait = "--wait" in args
        res = backup_now(wait=wait)
        print(json.dumps(res, indent=2))
    elif cmd in ("restore", "--restore"):
        commit = None
        if "--head" in args or "--local" in args:
            commit = "HEAD"
        for i, a in enumerate(args):
            if a in ("--commit", "--confirm-commit") and i + 1 < len(args):
                commit = args[i + 1]
                break
            elif a.startswith("--commit=") or a.startswith("--confirm-commit="):
                commit = a.split("=", 1)[1]
                break
        res = restore(commit=commit)
        print(json.dumps(res, indent=2))
    elif cmd in ("set-frequency", "--set-frequency"):
        if len(args) < 2:
            print(json.dumps({"success": False, "error": "Missing frequency value."}))
            sys.exit(1)
        res = set_frequency(args[1])
        print(json.dumps(res, indent=2))
    elif cmd in ("set-remote", "--set-remote"):
        if len(args) < 2:
            print(json.dumps({"success": False, "error": "Missing remote URL."}))
            sys.exit(1)
        res = set_remote(args[1])
        print(json.dumps(res, indent=2))
    elif cmd in ("set-branch", "--set-branch"):
        if len(args) < 2:
            print(json.dumps({"success": False, "error": "Missing branch name."}))
            sys.exit(1)
        res = set_branch(args[1])
        print(json.dumps(res, indent=2))
    elif cmd in ("logs", "--logs"):
        n = 25
        if len(args) > 1 and args[1].isdigit():
            n = int(args[1])
        res = get_logs(n)
        print(json.dumps(res, indent=2))
    elif cmd in ("help", "--help", "-h"):
        print("""omarchy-backup-ctl [COMMAND]

Commands:
  status                 Print current backup status, timer state, and git metadata (JSON)
  backup-now [--wait]    Trigger an immediate backup (asynchronous by default, or wait)
  restore --commit <SHA> | --head      Restore dotfiles at verified commit (--head for local HEAD)
  set-frequency <FREQ>   Set automated backup frequency: 1h, 2h, 4h, 6h, 12h, daily, disabled
  set-remote <URL>       Update Git remote target URL
  set-branch <BRANCH>    Update Git branch
  logs [N]               Get recent N backup log lines
""")
    else:
        print(json.dumps({"success": False, "error": f"Unknown command: {cmd}"}))
        sys.exit(1)


if __name__ == "__main__":
    main()
